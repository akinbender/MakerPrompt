<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Prevents VS Test Explorer from running the WASM and MAUI Playwright suites in
  parallel. Both suites launch application processes and Chromium instances.
  
  To use: Test Explorer → Settings gear → Configure Run Settings → Select Solution Wide runsettings File
  Or: dotnet test -s test.runsettings
-->
<RunSettings>
  <RunConfiguration>
    <!-- Run test assemblies one at a time, not in parallel -->
    <MaxCpuCount>1</MaxCpuCount>
    <!-- Allow time for application startup and Playwright/CDP attachment. -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>
</RunSettings>
