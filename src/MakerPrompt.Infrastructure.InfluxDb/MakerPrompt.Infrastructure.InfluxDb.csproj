<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MakerPrompt.Infrastructure.InfluxDb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official InfluxDB 2.x C# client — compatible with InfluxDB 2.x and 3.x (via compatibility API) -->
    <PackageReference Include="InfluxDB.Client" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MakerPrompt.Core\MakerPrompt.Core.csproj" />
  </ItemGroup>

</Project>
